// =============================================================================
// model Token —— API Key（程序化访问凭证）
// -----------------------------------------------------------------------------
// 用户在控制台生成的「API Key」在数据库里的存储形式。
// 客户端拿到的明文 key（如 dub_xxxxxxxx）只在生成时返回一次，
// 之后 DB 里只保留它的哈希（hashedKey），用于后续鉴权时比对，
// 避免拖库后明文泄露。一个用户可以拥有多个 Token（一对多），
// 例如生产环境、测试环境、CI bot 各一个。
// =============================================================================
model Token {
  // 主键：cuid 自动生成，全局唯一、不可猜测
  id String @id @default(cuid())

  // 用户给这个 key 起的友好名字（如 "Production"、"CI bot"），便于在控制台识别
  name String

  // ★ 核心：API Key 的哈希值（hashToken 算出来的单向哈希）
  //   - @unique：唯一索引，保证不同 key 哈希不冲突；同时让 withSession 里
  //     prisma.user.findFirst({ where: { tokens: { some: { hashedKey } } } })
  //     反查时最多命中一条
  //   - 明文 key 永不入库（详见 lib/auth/hash-token.ts）
  hashedKey String @unique

  // 明文 key 的「部分位」（如前缀 + 后缀），用于控制台显示 dub_xxxx...yyyy
  //   方便用户在不暴露完整 key 的前提下识别「这是哪个 key」
  partialKey String

  // 过期时间；null 表示永不过期（大多数 API Key 默认长期有效）
  expires DateTime?

  // 最近一次被使用的时间：withSession 鉴权成功后通过 waitUntil 异步更新
  //   （每分钟最多写一次，避免高 QPS 时对 DB 造成写放大，详见 session.ts）
  lastUsed DateTime?

  // 创建时间，默认当前时间
  createdAt DateTime @default(now())

  // 更新时间，Prisma 自动维护（任何字段变更都会刷新）
  updatedAt DateTime @updatedAt

  // 关系字段（虚拟）：指向所属 User，Prisma 通过 userId 外键自动 JOIN
  //   - onDelete: Cascade：用户被删除时，其名下所有 Token 一起删除，避免孤儿数据
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 外键：物理列，真实存在于 DB Token 表中，指向 User.id
  userId String

  // 给 userId 建索引：加速「按 user 反查他所有的 token」这类查询
  @@index([userId])
}

// =============================================================================
// model RestrictedToken —— 受限 API Key（带权限范围的工作区级 token）
// -----------------------------------------------------------------------------
// 它和上面的 Token 都是「API Key」，但定位不同：
//   · Token        —— 绑定到「用户」的旧版 key，权限 = 用户全部权限，没有收窄
//   · RestrictedToken —— 绑定到「workspace」的新版 key（明文以 dub_ 开头），
//                        额外带 scopes 权限范围，鉴权时会用 scopes 把权限「收窄」。
//
// 鉴权流程（见 lib/auth/workspace.ts）：
//   请求带 dub_ 开头的 key → 查 RestrictedToken → 用 token.scopes 把权限收窄 →
//   再校验接口要求的 requiredPermissions。
//
// 关键安全设计：
//   ① 明文 key 永不入库，只存哈希（hashedKey），防拖库泄露；
//   ② 控制台只展示脱敏 key（partialKey，形如 dub_xxxx...yyyy）；
//   ③ scopes 决定这个 key 能干什么，即便创建者权限很大，key 也只能用授权的子集。
// =============================================================================
model RestrictedToken {
  // 主键：cuid 自动生成，全局唯一、不可猜测
  id String @id @default(cuid())

  // 用户给这个 key 起的友好名字（如 "Production"、"CI bot"），便于在控制台识别
  name String

  // ★ 核心：API Key 的单向哈希值。
  //   - @unique：唯一索引，鉴权时按哈希反查最多命中一条；
  //   - 明文 key 只在创建时返回一次，之后永不入库（防拖库泄露）。
  hashedKey String @unique

  // 明文 key 的「部分位」（如前缀 + 后缀），控制台用来显示 dub_xxxx...yyyy，
  //   方便用户在不暴露完整 key 的前提下识别「这是哪个 key」。
  partialKey String

  // ★ 权限范围：空格分隔的字符串（如 "links.write domains.read"）。
  //   - 前端传数组 → 后端 join(" ") 存这里；读取时 split(" ") 还原成数组；
  //   - 鉴权时用它把权限「收窄」到创建者授权的子集（见 workspace.ts:463）；
  //   - null / 空串 → 视为没有额外权限（具体兜底逻辑看鉴权代码）。
  scopes String? // space separated (Eg: "links.write domains.read")

  // 过期时间；null 表示永不过期（大多数 API Key 默认长期有效）
  expires DateTime?

  // 最近一次被使用的时间：鉴权成功后通过 waitUntil 异步更新，
  //   每分钟最多写一次，避免高 QPS 时对 DB 造成写放大。
  lastUsed DateTime?

  // 创建时间，默认当前时间
  createdAt DateTime @default(now())

  // 更新时间，Prisma 自动维护（任何字段变更都会刷新）
  updatedAt DateTime @updatedAt

  // ★ 外键：这个 key 绑定到「哪个 workspace」（与 Token 绑定用户不同，
  //   RestrictedToken 是 workspace 级的）。
  projectId String

  // 外键：key 的归属用户（可能是真人，也可能是 Machine User 这种 bot 账号）。
  //   Machine User：独立 bot，不随创建者离开而删除；删除该 token 时会连带删 bot。
  userId String

  // 外键：如果这个 token 是由 OAuth 客户端生成的，指向对应的安装记录；
  //   普通手动创建的 key 这里是 null。
  installationId String? // if the token is generated by an OAuth client

  // ---------------------- 关系字段（虚拟，不占物理列）----------------------
  // 归属用户。onDelete: Cascade —— 用户被删，其名下 token 一起删除，避免孤儿数据。
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 归属 workspace。onDelete: Cascade —— workspace 被删，token 一起删除。
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 反向关系：一个 token 可以有多条 OAuth refresh token（OAuth 流程用）。
  refreshTokens        OAuthRefreshToken[]
  // 反向关系：如果由 OAuth 安装生成，指向那条安装记录；onDelete: Cascade。
  installedIntegration InstalledIntegration? @relation(fields: [installationId], references: [id], onDelete: Cascade)

  // ---------------------- 索引（加速查询）----------------------
  // 按 user 反查「某用户的所有 key」
  @@index([userId])
  // 按 workspace 反查「某 workspace 的所有 key」（控制台列表页常用）
  @@index([projectId])
  // 按 OAuth 安装记录反查（OAuth 流程用）
  @@index([installationId])
}

// Login tokens
// 一个用户点邮件里的链接
model VerificationToken {
  identifier String // 标识符 标识谁在验证,通常是邮箱之类的
  token      String   @unique // token 一次性
  expires    DateTime

  @@unique([identifier, token])
}

// Email verification OTPs
// 一种是用户输入邮件里的验证码
model EmailVerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Password reset tokens
model PasswordResetToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
